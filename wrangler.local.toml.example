# Cageathon World Cup 2026 — sweepstake worker
# Copy this file to wrangler.local.toml when you deploy from a laptop. That file is gitignored.
# A push to main does not need this file. Workers Builds inherits the live WC binding.
# Existing production must reuse the current WC namespace. Run `wrangler kv namespace list` and paste those ids.
# Do not run `wrangler kv namespace create` for an existing deploy. A new namespace orphans live draw and matches data.
# Account comes from `wrangler login` or CLOUDFLARE_ACCOUNT_ID. Do not set account_id.
name = "cageathon-world-cup-2026"
main = "src/worker.ts"
compatibility_date = "2026-01-15"
compatibility_flags = ["nodejs_compat"]

# Static frontend (HTML/CSS/JS + player avatars)
[assets]
directory = "./public"
binding = "ASSETS"
not_found_handling = "single-page-application"

# KV: draw, matches cache, last_updated, players roster
# Create with:  wrangler kv namespace create WC
[[kv_namespaces]]
binding = "WC"
id = "<YOUR_KV_NAMESPACE_ID>"
preview_id = "<YOUR_KV_PREVIEW_ID>"

[vars]
COMPETITION_ID = "2000"        # football-data.org World Cup
DRAW_SEED = "cageathon-reveal-2026"  # changing this re-derives the draw (requires POST /api/draw?force=1)
TOURNAMENT_START = "2026-06-11"

# Tournament over — cron disabled so we stop spending football-data quota.
# Manual refresh still works: POST /api/refresh with the admin token.
# Secrets needed:
#   wrangler secret put FOOTBALL_DATA_API_KEY
#   wrangler secret put ADMIN_TOKEN
[triggers]
crons = []

[observability]
enabled = true
